# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Deployed Public HTTPS URL (e.g., https://my-bot.onrender.com)
# When set, the bot will automatically register its webhook on server startup
WEBHOOK_URL=https://your-deployed-service.onrender.com

# Port (configured automatically by cloud host)
PORT=8000
